+async fn interleave_scenario(cwd: &str, home: &Path) -> JsValue {
+    let calls = Calls::default();
+    let registry = AgentStorage::new(home.join("interleave"));
+    let fake = spec("fake");
+    scripted(&fake, &["interleaveA", "interleaveB"]);
+    let sessions = Arc::clone(&fake.sessions);
+    let manager = manager_with(&calls, &registry, vec![(fake, enabled())]);
+    let feed = record_feed(&manager);
+    for id in [AGENT_ID, OTHER_ID] {
+        manager
+            .create_agent(
+                object(vec![("provider", text("fake")), ("cwd", text(cwd))]),
+                Some(id.to_owned()),
+                CreateAgentOptions::default(),
+            )
+            .await
+            .expect("create");
+    }
+    let runs: Vec<_> = [(AGENT_ID, "a"), (OTHER_ID, "b")]
+        .into_iter()
+        .map(|(id, prompt)| {
+            let manager = manager.clone();
+            tokio::spawn(async move {
+                outcome(
+                    manager
+                        .run_agent(id, AgentPromptInput::Text(prompt.to_owned()), None)
+                        .await
+                        .map(|run| run.to_js()),
+                )
+            })
+        })
+        .collect();
+    wait_for_turn_started(&feed, "turn-11").await;
+    wait_for_turn_started(&feed, "turn-12").await;
+    // One synchronous loop: no await between the two sessions' events.
+    {
+        let sessions = sessions.lock().expect("sessions");
+        for entry in json(SCENARIO_TURNS)
+            .get("interleaved")
+            .and_then(JsValue::as_array)
+            .expect("interleaved")
+        {
+            let entry = entry.as_array().expect("entry");
+            #[allow(
+                clippy::cast_possible_truncation,
+                clippy::cast_sign_loss,
+                reason = "scripted session indexes are 0 or 1"
+            )]
+            let index = entry[0].as_f64().expect("index") as usize;
+            let callbacks = sessions[index].lock().expect("listeners").clone();
+            for callback in &callbacks {
+                callback(entry[1].clone());
+            }
+        }
+    }
+    let mut results = Vec::new();
+    for run in runs {
+        results.push(run.await.expect("join"));
+    }
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    manager.flush().await;
+    registry.flush().await;
+    let feed = feed.lock().expect("feed").clone();
+    object(vec![
+        ("results", JsValue::Array(results)),
+        ("feed", JsValue::Array(feed)),
+    ])
+}
