{
  "workerInitialize": {
    "type": "initialize",
    "pluginId": "review",
    "bundle": "bundle",
    "appVersion": "0.8.0",
    "pluginDirectory": "/plugins/review",
    "settingsDirectory": "/settings/review"
  },
  "workerReady": {
    "type": "ready",
    "methods": ["review.start"],
    "providers": [],
    "usageSources": [],
    "hooks": { "events": [], "before": [] }
  },
  "workerInvoke": {
    "type": "invoke",
    "requestId": "worker-1",
    "method": "review.start",
    "input": { "change": 7 }
